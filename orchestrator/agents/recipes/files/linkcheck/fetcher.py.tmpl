"""Default network access: the only module of the package that opens sockets.

``HttpFetcher`` performs ONE GET and reads only the status line and the headers. It connects to
the addresses the guard validated (the name is never resolved again), never follows a redirect,
ignores proxy environment variables and sends neither cookies nor credentials. The time budget
is a TOTAL deadline for connecting, TLS, sending and reading the head, so a server that trickles
bytes cannot keep an attempt alive past it.
"""

from __future__ import annotations

import re
import socket
import ssl
import threading
import time
from collections.abc import Callable
from typing import Protocol

from linkcheck.model import (
    FetchError,
    FetchRequest,
    FetchResponse,
    FetchTimeout,
    ResolutionError,
    ResolutionTimeout,
)

Connect = Callable[[tuple[str, int], float], socket.socket]

MAX_HEAD_BYTES = 16 * 1024
USER_AGENT = "linkcheck/1.0"
_STATUS = re.compile(rb"HTTP/1\.[01] ([0-9]{3})(?![0-9])")
_TARGET = re.compile(r"/[\x21-\x7e]*")
_HOST = re.compile(r"[A-Za-z0-9_.:-]+")


class TlsContext(Protocol):
    """The part of ``ssl.SSLContext`` the fetcher uses (injectable for tests)."""

    def wrap_socket(self, sock: socket.socket, *, server_hostname: str) -> socket.socket: ...


def system_resolver(host: str, timeout: float = 5.0) -> list[str]:
    """Addresses of ``host`` from the operating system, abandoned after ``timeout`` seconds.

    ``getaddrinfo`` cannot be interrupted, so it runs in a daemon thread that is left to finish
    in the background when the time budget is exhausted.
    """
    box: list[list[str] | OSError] = []

    def lookup() -> None:
        try:
            infos = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
            box.append([str(info[4][0]) for info in infos])
        except OSError as exc:
            box.append(exc)

    worker = threading.Thread(target=lookup, daemon=True)
    worker.start()
    worker.join(timeout)
    if not box:
        raise ResolutionTimeout("name resolution timed out")
    found = box[0]
    if isinstance(found, OSError):
        raise ResolutionError("host name does not resolve")
    return found


def _head(request: FetchRequest) -> bytes:
    host = f"[{request.host}]" if ":" in request.host else request.host
    if request.port != (443 if request.scheme == "https" else 80):
        host += f":{request.port}"
    head = f"GET {request.target} HTTP/1.1\r\nHost: {host}\r\nUser-Agent: {USER_AGENT}\r\n"
    head += "Accept: */*\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n"
    return head.encode("ascii")


def _parse(head: bytes) -> FetchResponse:
    match = _STATUS.match(head)
    if match is None:
        raise FetchError("invalid_response")
    location = None
    for line in head.split(b"\r\n")[1:]:
        name, _, value = line.partition(b":")
        if name.strip().lower() == b"location":
            location = value.strip().decode("latin-1")
            break
    return FetchResponse(int(match.group(1)), location)


class HttpFetcher:
    """The default ``Fetcher``; ``connect``, ``tls`` and ``clock`` are injectable for tests."""

    def __init__(
        self,
        *,
        connect: Connect = socket.create_connection,
        tls: TlsContext | None = None,
        clock: Callable[[], float] = time.monotonic,
    ) -> None:
        self._connect = connect
        self._tls = tls
        self._clock = clock

    def fetch(self, request: FetchRequest) -> FetchResponse:
        if (
            request.scheme not in ("http", "https")
            or not _TARGET.fullmatch(request.target)
            or not _HOST.fullmatch(request.host)
        ):
            raise FetchError("invalid_request")
        deadline = self._clock() + request.timeout_seconds
        try:
            sock = self._open(request, deadline)
            try:
                sock.settimeout(self._left(deadline))
                sock.sendall(_head(request))
                return _parse(self._read_head(sock, deadline))
            finally:
                sock.close()
        except TimeoutError:
            raise FetchTimeout from None
        except ssl.SSLError:
            raise FetchError("tls_failed") from None
        except OSError:
            raise FetchError("connection_failed") from None

    def _left(self, deadline: float) -> float:
        left = deadline - self._clock()
        if left <= 0:
            raise FetchTimeout
        return left

    def _open(self, request: FetchRequest, deadline: float) -> socket.socket:
        failure: OSError | None = None
        for address in request.addresses:
            try:
                sock = self._connect((address, request.port), self._left(deadline))
            except OSError as exc:
                failure = exc
            else:
                return self._secure(sock, request, deadline)
        raise failure or FetchError("connection_failed")

    def _secure(self, sock: socket.socket, request: FetchRequest, deadline: float) -> socket.socket:
        if request.scheme != "https":
            return sock
        try:
            sock.settimeout(self._left(deadline))
            if self._tls is None:  # building a context loads the CA store: do it once
                self._tls = ssl.create_default_context()
            return self._tls.wrap_socket(sock, server_hostname=request.host)
        except BaseException:
            sock.close()
            raise

    def _read_head(self, sock: socket.socket, deadline: float) -> bytes:
        data = b""
        while b"\r\n\r\n" not in data:
            sock.settimeout(self._left(deadline))
            chunk = sock.recv(4096)
            if not chunk:
                break
            data += chunk
            if len(data) > MAX_HEAD_BYTES:
                raise FetchError("response_head_too_large")
        return data.split(b"\r\n\r\n", 1)[0]
