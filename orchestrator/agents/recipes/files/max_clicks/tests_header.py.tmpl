"""Click limits (``max_clicks``): tests generated by the ``max_clicks`` recipe.

Each test names the requirement and acceptance criteria it verifies on a ``Covers:`` line of its
docstring, and each one fails on the code base this change was made against (it needs the feature).
"""

from __future__ import annotations

@@IMPORTS@@

Headers = dict[str, str]

LIMIT_KEYS = {"max_clicks", "remaining_clicks"}
MIN_CLICKS = @@MIN_VALUE@@
MAX_CLICKS = @@MAX_VALUE@@
DESTINATION = "https://example.com/campaign"
STORED_AT = "2026-01-01T00:00:00.000000Z"  # the storage format of timestamps (UTC, microseconds)
POLICY = UrlPolicy(own_hosts=frozenset({"sho.example.com"}))


def create(client: TestClient, headers: Headers, **extra: Any) -> Any:
    """POST /api/v1/links for the fixed destination; ``extra`` adds request fields."""
    return client.post("/api/v1/links", json={"url": DESTINATION, **extra}, headers=headers)


def limited(client: TestClient, headers: Headers, max_clicks: int) -> str:
    """Create a link with a click limit and return its code."""
    response = create(client, headers, max_clicks=max_clicks)
    assert response.status_code == 201
    return str(response.json()["code"])


def details(client: TestClient, headers: Headers, code: str) -> dict[str, Any]:
    response = client.get(f"/api/v1/links/{code}", headers=headers)
    assert response.status_code == 200
    body: dict[str, Any] = response.json()
    return body


def flush(services: Services) -> None:
    assert services.recorder.flush(timeout=5)


def run_concurrently(count: int, work: Callable[[int], Any]) -> list[Any]:
    """Run ``work(index)`` on ``count`` threads released together; results keep their index."""
    barrier = threading.Barrier(count)

    def job(index: int) -> Any:
        barrier.wait(timeout=10)
        return work(index)

    with ThreadPoolExecutor(max_workers=count) as pool:
        return list(pool.map(job, range(count)))


class CountingRepository(SqliteLinkRepository):
    """Counts the repository calls the redirect path makes."""

    def __init__(self, database: Database) -> None:
        super().__init__(database)
        self.lookups = 0
        self.consumed = 0

    def get_by_code(self, code: str) -> Link | None:
        self.lookups += 1
        return super().get_by_code(code)

    def consume_click(self, code: str) -> bool:
        self.consumed += 1
        return super().consume_click(code)


class Harness:
    """A ``LinkService`` over the migrated test database with a visible redirect cache."""

    def __init__(self, database: Database, clock: FakeClock) -> None:
        self.repository = CountingRepository(database)
        self.cache: RedirectCache = LruTtlCache(max_entries=100, default_ttl=60, clock=clock)
        self.service = LinkService(
            links=self.repository,
            codes=CodeGenerator(),
            cache=self.cache,
            clock=clock,
            url_policy=POLICY,
            metrics=Metrics(),
            negative_ttl=5,
        )

    def create(self, **extra: Any) -> Link:
        return self.service.create(url="https://example.com/a", owner="alice", **extra)


def old_schema_database(path: Path) -> None:
    """Create ``path`` at the schema *before* the click-limit migration, with two seeded links."""
    migrations = load_migrations()
    assert migrations[-1].name == "add_max_clicks"
    database = Database(path)
    database.open()
    try:
        migrate(database, migrations[:-1])
        with database.transaction() as connection:
            connection.executemany(
                "INSERT INTO links (code, original_url, created_at, click_count, created_by) "
                "VALUES (?, ?, ?, ?, ?)",
                [
                    ("seed-one", "https://example.com/1", STORED_AT, 4, "alice"),
                    ("seed-two", "https://example.com/2", STORED_AT, 0, "alice"),
                ],
            )
    finally:
        database.close()
