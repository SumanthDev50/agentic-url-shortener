def test_links_without_a_limit_keep_the_v1_json_shape(client: TestClient, alice: Headers) -> None:
    """Responses for unlimited links carry no new keys; limited links add exactly two.

    Covers: @@COVERS@@
    """
    unlimited = create(client, alice)
    sibling = create(client, alice, max_clicks=2)
    assert (unlimited.status_code, sibling.status_code) == (201, 201)
    assert LIMIT_KEYS.isdisjoint(unlimited.json())
    assert set(sibling.json()) == set(unlimited.json()) | LIMIT_KEYS
    assert LIMIT_KEYS.isdisjoint(details(client, alice, unlimited.json()["code"]))


def test_unlimited_link_is_not_affected_by_a_used_up_sibling(
    client: TestClient, services: Services, alice: Headers
) -> None:
    """A link without a limit keeps redirecting and keeps being counted by the writer.

    Covers: @@COVERS@@
    """
    capped = limited(client, alice, 1)
    free = create(client, alice).json()["code"]
    assert client.get(f"/{capped}").status_code == 302
    assert client.get(f"/{capped}").status_code == 410
    assert [client.get(f"/{free}").status_code for _ in range(25)] == [302] * 25
    flush(services)
    assert details(client, alice, free)["click_count"] == 25


def test_links_without_a_limit_keep_the_cached_fast_path(
    migrated_database: Database, clock: FakeClock
) -> None:
    """Unlimited links never touch the atomic consume; limited ones consume once per redirect.

    Covers: @@COVERS@@
    """
    harness = Harness(migrated_database, clock)
    free, capped = harness.create(), harness.create(max_clicks=50)
    for _ in range(5):
        harness.service.resolve(free.code)
    assert (harness.repository.lookups, harness.repository.consumed) == (1, 0)
    for _ in range(5):
        harness.service.resolve(capped.code)
    assert (harness.repository.lookups, harness.repository.consumed) == (2, 5)


def test_application_migrates_an_old_database_and_old_links_stay_unlimited(tmp_path: Path) -> None:
    """Startup migrates a pre-change database: /readyz passes, old links redirect as before.

    Covers: @@COVERS@@
    """
    path = tmp_path / "old.db"
    old_schema_database(path)
    secret = new_secret()
    app = build_app(make_settings(path, keys={"alice": secret}), clock=FakeClock())
    with api_client(app) as client:
        assert client.get("/readyz").status_code == 200
        assert [client.get("/seed-one").status_code for _ in range(5)] == [302] * 5
        shown = details(client, {"X-API-Key": secret}, "seed-one")
        assert (LIMIT_KEYS.isdisjoint(shown), shown["status"]) == (True, "active")
    with sqlite3.connect(path) as connection:
        rows = connection.execute("SELECT code, max_clicks FROM links ORDER BY id").fetchall()
    assert rows == [("seed-one", None), ("seed-two", None)]


def test_idempotency_fingerprint_of_unlimited_requests_is_unchanged(
    client: TestClient, alice: Headers
) -> None:
    """A request without a limit hashes as before; a different limit under one key is refused.

    Covers: @@COVERS@@
    """
    from shortener.api.schemas import CreateLinkRequest

    old: dict[str, object] = dict.fromkeys(("alias", "expires_at", "ttl_seconds"))
    payload = CreateLinkRequest(url=DESTINATION).fingerprint_payload()
    assert request_fingerprint(payload) == request_fingerprint({"url": DESTINATION, **old})
    headers = {**alice, "Idempotency-Key": "campaign-key-1"}
    first = create(client, headers, max_clicks=5)
    assert create(client, headers, max_clicks=5).json() == first.json()  # replayed
    changed = create(client, headers, max_clicks=6)
    assert (changed.status_code, changed.json()["error"]["code"]) == (422, "idempotency_key_reuse")
