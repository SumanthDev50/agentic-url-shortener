@@@ edit consume-click-method
@@@ anchor
    def _lookup(self, code: str) -> CachedTarget:
@@@ replace
    def _consume_click(self, code: str) -> None:
        """Take one click from a limited link's allowance; the database alone decides."""
        if self._links.consume_click(code):
            return
        self._cache.invalidate(code)  # the allowance is used up (or the link changed): drop it
        link = self._links.get_by_code(code)
        if link is None:
            raise LinkNotFoundError
        if link.disabled_at is not None:
            raise LinkGoneError(LinkStatus.DISABLED, "The link has been disabled.")
        raise LinkGoneError(LinkStatus.EXHAUSTED, "The link has reached its click limit.")

    def _lookup(self, code: str) -> CachedTarget:
@@@ end

