@@@ edit consume-and-add-clicks
@@@ anchor
    def add_clicks(self, counts: Mapping[int, int]) -> None:
        if not counts:
            return
        with self._database.transaction() as connection:
            connection.executemany(
                "UPDATE links SET click_count = click_count + ? WHERE id = ?",
                [(count, link_id) for link_id, count in counts.items()],
            )
@@@ replace
    def consume_click(self, code: str) -> bool:
        # One conditional UPDATE is the whole decision: SQLite serialises writers, so of N
        # concurrent requests at most (max_clicks - click_count) see ``rowcount == 1``.
        with self._database.transaction() as connection:
            cursor = connection.execute(
                "UPDATE links SET click_count = click_count + 1 "
                "WHERE code = ? AND disabled_at IS NULL "
                "AND (max_clicks IS NULL OR click_count < max_clicks)",
                (code,),
            )
        return cursor.rowcount > 0

    def add_clicks(self, counts: Mapping[int, int]) -> None:
        if not counts:
            return
        with self._database.transaction() as connection:
            connection.executemany(
                # Limited links are counted by ``consume_click`` at redirect time, never here.
                "UPDATE links SET click_count = click_count + ? "
                "WHERE id = ? AND max_clicks IS NULL",
                [(count, link_id) for link_id, count in counts.items()],
            )
@@@ end

