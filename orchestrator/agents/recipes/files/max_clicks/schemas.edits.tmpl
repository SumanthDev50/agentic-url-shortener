        except ValueError:
            raise ValueError("expires_at must be an ISO-8601 date-time with a UTC offset") from None

    def fingerprint_payload(self) -> dict[str, object]:
        """Payload hashed for idempotency: a request without a limit hashes exactly as before."""
        payload: dict[str, object] = self.model_dump(mode="json")
        if self.max_clicks is None:
            del payload["max_clicks"]
        return payload
@@@ end

