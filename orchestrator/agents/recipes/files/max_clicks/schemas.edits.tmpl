@@@ edit click-count-and-limit-fields
@@@ anchor
    click_count: int = Field(
        description="Recorded clicks. Eventually consistent: updated by a background writer."
    )
@@@ replace
    click_count: int = Field(
        description=(
            "Recorded clicks. Eventually consistent for links without a limit (updated by a "
            "background writer); exact for links with a click limit."
        )
    )
    max_clicks: int | None = Field(
        default=None, description="The click limit. Omitted for links without one."
    )
    remaining_clicks: int | None = Field(
        default=None,
        description="Redirects left before the link answers 410. Omitted for unlimited links.",
    )

    # Deliberately without type hints: pydantic derives the OpenAPI schema from a return
    # annotation, and a ``dict`` annotation would replace the properties by a free-form object.
    @model_serializer(mode="wrap")
    def _omit_missing_limit(self, handler):
        """Links without a limit serialise exactly as before: no new keys at all."""
        data = handler(self)
        if self.max_clicks is None:
            data.pop("max_clicks", None)
            data.pop("remaining_clicks", None)
        return data
@@@ end

